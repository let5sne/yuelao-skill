#!/usr/bin/env bash
# 红娘 CLI v0.3 — 统一入口
#
# 所有后端交互和本地状态管理都在这一个脚本里。
# 本地文件（默认 ~/.yuelao/，可用 YUELAO_HOME 覆盖）：
#   config.json         user_id / api_token / backend_url / contact（联系方式只存本地）
#   state.json          上次同步的推荐状态快照、已见消息、筛选记录、交换记录、反馈记录
#   profile-cache.json  档案本地缓存（增量更新时深度合并用）
#
# 用法: yuelao <command> [args]，运行 yuelao help 查看全部命令。

set -euo pipefail
CLI_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

HN_DIR="${YUELAO_HOME:-$HOME/.yuelao}"
CONFIG="$HN_DIR/config.json"
STATE="$HN_DIR/state.json"
CACHE="$HN_DIR/profile-cache.json"
# 必须与 API_BASE 指向同一个实例。0.4 改名时把 API 路径从 /api/v1/hongniang/*
# 改成了 /api/v1/yuelao/*，但这一行漏了——它还指向 v0.2 的旧实例
# （43.163.116.103:8010，现在跑的是另一个 Express 应用，对任何路径都回 HTML 404）。
# 后果：不带 backend 参数的 register 全部失败，上线以来无人注册成功。
# 改这一行时记得连带检查 API_BASE 与线上部署是否一致。
DEFAULT_BACKEND="https://yuelao.ciyuanlife.cn"
API_BASE="/api/v1/yuelao"

err() { echo "ERROR: $*" >&2; exit 1; }

for c in curl jq python3; do
  command -v "$c" >/dev/null 2>&1 || err "$c is required but not installed."
done

# 必须在 jq/命令替换处理用户数据之前校验，不能让宽容解码悄悄替换坏字节。
require_utf8() {
  python3 "$CLI_DIR/check-utf8.py" || exit 1
}

read_json_input() {
  if [[ "$1" == "-" ]]; then
    python3 "$CLI_DIR/check-utf8.py" --json --echo
  elif [[ -f "$1" ]]; then
    python3 "$CLI_DIR/check-utf8.py" --json --echo < "$1"
  else
    printf '%s' "$1" | python3 "$CLI_DIR/check-utf8.py" --json --echo
  fi
}

# ---------- 配置 ----------

# v0.1 的 config.yaml 自动迁移为 config.json
migrate_config() {
  local old="$HN_DIR/config.yaml"
  if [[ -f "$CONFIG" || ! -f "$old" ]]; then return 0; fi
  require_utf8 < "$old"
  local uid tok url ctype cval
  uid=$(grep '^user_id:' "$old" 2>/dev/null | sed 's/^user_id:[[:space:]]*//' | tr -d "'\"" || true)
  tok=$(grep '^api_token:' "$old" 2>/dev/null | sed 's/^api_token:[[:space:]]*//' | tr -d "'\"" || true)
  url=$(grep '^backend_url:' "$old" 2>/dev/null | sed 's/^backend_url:[[:space:]]*//' | tr -d "'\"" || true)
  ctype=$(awk '/^contact:/{f=1;next} f&&/^[^ ]/{f=0} f&&/^  type:/{sub(/^  type:[[:space:]]*/,"");gsub(/['\''"]/,"");print}' "$old" || true)
  cval=$(awk '/^contact:/{f=1;next} f&&/^[^ ]/{f=0} f&&/^  value:/{sub(/^  value:[[:space:]]*/,"");gsub(/['\''"]/,"");print}' "$old" || true)
  [[ -n "$uid" && -n "$tok" ]] || return 0
  mkdir -p "$HN_DIR"
  jq -n --arg u "$uid" --arg t "$tok" --arg b "${url:-$DEFAULT_BACKEND}" \
        --arg ct "${ctype:-}" --arg cv "${cval:-}" \
    '{user_id:$u, api_token:$t, backend_url:$b, contact:{type:$ct, value:$cv}}' > "$CONFIG"
  chmod 600 "$CONFIG"
  echo "Migrated config.yaml -> config.json" >&2
}

cfg() { jq -r ".$1 // empty" "$CONFIG"; }

require_config() {
  migrate_config
  [[ -f "$CONFIG" ]] || err "Not registered. Run: yuelao register '<profile_json>'"
}

# ---------- 本地状态 ----------

ensure_state() {
  mkdir -p "$HN_DIR"
  if [[ ! -f "$STATE" ]]; then
    echo '{"recs":{},"seen_messages":[],"filters":{},"exchanges":{},"feedback":[],"last_sync":0}' > "$STATE"
    chmod 600 "$STATE"
  fi
}

update_state() { # usage: update_state [--arg k v ...] '<jq program>'
  local tmp
  tmp=$(mktemp)
  jq "$@" "$STATE" > "$tmp" && mv "$tmp" "$STATE"
  chmod 600 "$STATE"
}

# ---------- API ----------

api() { # api METHOD PATH [JSON_DATA]
  local method="$1" path="$2" data="${3:-}"
  # 生成 payload 时若旧缓存中的损坏被 jq 转成 U+FFFD，也不能继续发送。
  if [[ -n "$data" ]]; then require_json "$data"; fi
  local url token resp code body
  url="$(cfg backend_url)${path}"
  token="$(cfg api_token)"
  local args=(-sS --max-time 20 -X "$method"
              -H "Content-Type: application/json"
              -H "Authorization: Bearer ${token}"
              -w $'\n%{http_code}')
  if [[ "$method" == "GET" ]]; then args+=(--retry 2); fi
  if [[ -n "$data" ]]; then args+=(-d "$data"); fi
  resp=$(curl "${args[@]}" "$url") || { echo "ERROR: network failure calling ${path}" >&2; return 1; }
  code=$(printf '%s\n' "$resp" | tail -n1)
  body=$(printf '%s\n' "$resp" | sed '$d')
  if [[ "$code" -ge 400 ]]; then
    echo "ERROR: HTTP $code from ${path}" >&2
    echo "$body" >&2
    return 1
  fi
  printf '%s\n' "$body"
}

require_json() {
  printf '%s' "$1" | python3 "$CLI_DIR/check-utf8.py" --json || exit 1
}

# 资格信息透出。写档案的三个入口（register / profile update / profile set）都要输出它，
# 所以只有一份实现——曾经的问题正是"三个入口各写各的，两个忘了透出"。
#
# 刻意**不用** `// true` 之类的兜底：jq 的 `//` 把 false 当空值，会让
# `false // true == true`，于是所有不合格的用户都被报成合格，整个闸门对用户隐形
# （见 CHANGELOG 0.2）。字段不存在时这里输出 null，如实表示"这个后端不告诉我们"，
# 绝不替服务端假装 matchable:true。
print_eligibility() { # print_eligibility <响应 JSON>
  printf '%s\n' "$1" | jq '{matchable, missing_fields, missing_labels}'
}

# ID 可能是自增整数也可能是 UUID：能转数字就按数字发，否则原样按字符串发。
# （sync 内部一律按字符串比较，这里只影响出网 payload 的类型。）
JQ_ID='def as_id: . as $s | try ($s | tonumber) catch $s;'

# ---------- 命令 ----------

cmd_register() {
  local input="${1:-}" backend="${2:-$DEFAULT_BACKEND}"
  [[ -n "$input" ]] || err "Usage: yuelao register '<json>' [backend_url]  (or '-' for stdin)"
  local json
  json=$(read_json_input "$input") || exit 1
  migrate_config
  [[ -f "$CONFIG" ]] && err "Already registered ($CONFIG exists). Use 'yuelao profile update' instead."

  local resp code body uid tok
  resp=$(curl -sS --max-time 30 -X POST -H "Content-Type: application/json" \
              -w $'\n%{http_code}' -d "$json" "${backend}${API_BASE}/profile") \
    || err "network failure calling ${backend}"
  code=$(printf '%s\n' "$resp" | tail -n1)
  body=$(printf '%s\n' "$resp" | sed '$d')
  [[ "$code" -ge 400 ]] && err "Registration failed with HTTP $code: $body"
  uid=$(echo "$body" | jq -r '.user_id // empty')
  tok=$(echo "$body" | jq -r '.api_token // empty')
  [[ -n "$uid" && -n "$tok" ]] || err "Invalid response from server: $body"

  mkdir -p "$HN_DIR"
  jq -n --arg u "$uid" --arg t "$tok" --arg b "$backend" \
    '{user_id:$u, api_token:$t, backend_url:$b, contact:{type:"", value:""}}' > "$CONFIG"
  chmod 600 "$CONFIG"
  echo "$json" | jq . > "$CACHE"
  chmod 600 "$CACHE"
  ensure_state
  echo "Registered. user_id: $uid"
  echo "Next: save contact info locally with: yuelao contact set wechat <微信号>"
  # 注册响应里带着资格信息（有没有到能参与匹配的门槛）。不透出的话，红娘会照
  # SKILL.md 承诺"今晚开始匹配"，而用户其实还在闸门外——这两个状态对用户完全不同
  # （一个要补档案，一个只能等）。api_token 不回显，它只该写进 config.json。
  print_eligibility "$body"
}

cmd_contact() {
  require_config
  case "${1:-}" in
    set)
      local type="${2:-}" value="${3:-}"
      [[ -n "$type" && -n "$value" ]] || err "Usage: yuelao contact set <type> <value>  e.g. contact set wechat abc123"
      local tmp; tmp=$(mktemp)
      jq --arg t "$type" --arg v "$value" '.contact = {type:$t, value:$v}' "$CONFIG" > "$tmp" && mv "$tmp" "$CONFIG"
      chmod 600 "$CONFIG"
      echo "Contact saved locally (${type}). It is only sent to the server when you explicitly exchange after a mutual match."
      ;;
    get) jq '.contact' "$CONFIG" ;;
    *) err "Usage: yuelao contact <set|get> [type value]" ;;
  esac
}

# HTTP 成功还需验证响应形状；异常响应不能被当成空列表覆盖快照。
sync_fetch() { # sync_fetch <path> <jq validation/normalization>
  local raw
  raw=$(api GET "$1") || return 1
  printf '%s\n' "$raw" | jq -e -s "
    if length == 1 then .[0] else error(\"expected one JSON value\") end
    | $2"
}

JQ_SYNC_LIST='
  def valid_id: (type == "string" and length > 0) or type == "number";
  if type == "array" then .
  elif type == "object" and (.[$key] | type) == "array" then .[$key]
  else error("expected list") end
  | if all(.[]; type == "object" and
      (if $key == "messages" then (.id | valid_id)
       else ((.id // .recommendation_id) | valid_id) and
         (.status == null or (.status | type) == "string") end))
    then . else error("invalid list item") end'

cmd_sync() {
  require_config; ensure_state
  local uid; uid=$(cfg user_id)

  # 每类查询单独记录成败。网络故障不能伪装成"没有数据"——否则红娘会跟用户说
  # "暂时没新进展"，而实际上是后端不可用。
  local errors='[]' recs_ok=1 inbox_ok=1 profile_ok=1 pause_ok=1
  local recs_raw inbox_raw pause_raw
  recs_raw=$(sync_fetch "${API_BASE}/recommendations/${uid}" "\"recommendations\" as \$key | $JQ_SYNC_LIST" 2>/dev/null) || {
    recs_raw='[]'; recs_ok=0
    errors=$(echo "$errors" | jq '. + ["recommendations: 拉取失败"]')
  }
  inbox_raw=$(sync_fetch "${API_BASE}/messages/${uid}" "\"messages\" as \$key | $JQ_SYNC_LIST" 2>/dev/null) || {
    inbox_raw='[]'; inbox_ok=0
    errors=$(echo "$errors" | jq '. + ["messages: 拉取失败"]')
  }
  pause_raw=$(sync_fetch "${API_BASE}/profile/${uid}/pause" '
    if type == "object" and (.status == "active" or .status == "paused")
    then . else error("invalid pause response") end' 2>/dev/null) || {
    pause_raw='{}'; pause_ok=0
    errors=$(echo "$errors" | jq '. + ["pause: 拉取失败"]')
  }
  # 档案本身也要拉：matchable 只在 /profile 的响应里。不拉的话，"档案不完整所以
  # 不参与匹配"这件事永远到不了红娘手上——她会日复一日看到空的推荐列表，
  # 然后跟用户说"暂时没有合适的人"，而真实原因是用户还没填性别/年龄/城市。
  local profile_raw
  profile_raw=$(sync_fetch "${API_BASE}/profile/${uid}" '
    if type == "object" and (.summary | type) == "object" and (.preferences | type) == "object"
    then . else error("invalid profile response") end' 2>/dev/null) || {
    profile_raw='{}'; profile_ok=0
    errors=$(echo "$errors" | jq '. + ["profile: 拉取失败"]')
  }
  local recs="$recs_raw" inbox="$inbox_raw"

  # 对"已提交联系方式但还没拿到对方的"匹配，自动查一次交换进度
  local new_contacts='[]' mid sub got res c
  for mid in $(echo "$recs" | jq -r '.[] | select((.status // "") == "matched") | (.match_id // .id) | tostring'); do
    sub=$(jq -r --arg m "$mid" '.exchanges[$m].submitted // false' "$STATE")
    got=$(jq -r --arg m "$mid" '.exchanges[$m].partner_contact // empty' "$STATE")
    if [[ "$sub" == "true" && -z "$got" ]]; then
      res=$(api GET "${API_BASE}/exchange/${mid}?user_id=${uid}" 2>/dev/null) || res='{}'
      c=$(echo "$res" | jq -r '.contact // empty')
      if [[ -n "$c" ]]; then
        update_state --arg m "$mid" --arg c "$c" \
          '.exchanges[$m].partner_contact = $c | .exchanges[$m].received_at = (now|floor)'
        new_contacts=$(echo "$new_contacts" | jq --arg m "$mid" --arg c "$c" '. + [{match_id:$m, contact:$c}]')
      fi
    fi
  done

  # 与上次快照对比，生成变化摘要
  jq -n \
    --argjson recs "$recs" \
    --argjson inbox "$inbox" \
    --argjson pause "$pause_raw" \
    --argjson profile "$profile_raw" \
    --argjson profile_ok "$profile_ok" \
    --argjson pause_ok "$pause_ok" \
    --argjson newc "$new_contacts" \
    --argjson old "$(jq '.recs' "$STATE")" \
    --argjson seen "$(jq '.seen_messages' "$STATE")" \
    --argjson filters "$(jq '.filters' "$STATE")" \
    --argjson exch "$(jq '.exchanges' "$STATE")" \
    --argjson fb "$(jq '.feedback' "$STATE")" \
    --argjson errors "$errors" '
    def rid: ((.id // .recommendation_id // "") | tostring);
    {
      synced_at: (now | floor),
      paused: (if $pause_ok == 1 then $pause.status else null end),
      partial: (($errors | length) > 0),
      errors: $errors,
      # 老服务端不返回 matchable，此时按 true 处理（不凭空报警）。
      #
      # 必须用 has() 而不是 (.matchable // true)：jq 的 // 把 false 也当空值，
      # 所以 false // true == true——那会让**所有**不合格的用户被报成合格，
      # 红娘照旧什么都不问，这个功能就等于没做。
      matchable: (if $profile_ok == 0 then null
                  elif ($profile|has("matchable")) then $profile.matchable else true end),
      missing_labels: ($profile.missing_labels // []),
      changes: {
        new_recommendations: [ $recs[] | select($old[rid] == null) | rid ],
        status_changes: [ $recs[] | rid as $r
          | select(($old[$r] != null) and ($old[$r] != (.status // "unknown")))
          | {id: $r, from: $old[$r], to: (.status // "unknown")} ],
        new_messages: [ $inbox[] | select( ((.id | tostring) as $i | ($seen | index($i)) | not) ) ],
        contacts_received: $newc
      },
      needs_filter: [ $recs[] | select((.status // "") == "pending") | select($filters[rid] == null) ],
      recommendations: ($recs | group_by(.status // "unknown")
        | map({key: (.[0].status // "unknown"), value: .}) | from_entries),
      inbox_unread: [ $inbox[] | select((.read_at // null) == null) ],
      followups_due: [ $recs[] | select((.status // "") == "matched") | rid as $r
        | ((.match_id // .id) | tostring) as $m
        | select($exch[$m].partner_contact != null)
        | select(($fb | index($r)) == null)
        | ((now - ($exch[$m].received_at // now)) / 86400 | floor) as $d
        | select($d >= 3)
        | {rec_id: $r, match_id: $m, days_since_contact: $d} ]
    }'

  # 更新快照。只覆盖拉取成功的部分：如果 recommendations 拉取失败而这里照样把
  # .recs 写成 {}，下次 sync 成功时全部推荐都会被当成"新推荐"重报一遍。
  update_state --argjson recs "$recs" --argjson inbox "$inbox" \
               --argjson recs_ok "$recs_ok" --argjson inbox_ok "$inbox_ok" '
    def rid: ((.id // .recommendation_id // "") | tostring);
    (if $recs_ok == 1
       then .recs = ($recs | map({key: rid, value: (.status // "unknown")}) | from_entries)
       else . end)
    | (if $inbox_ok == 1
         then .seen_messages = ((.seen_messages + ($inbox | map(.id | tostring))) | unique)
         else . end)
    | .last_sync = (now | floor)'
}

cmd_filter() {
  require_config; ensure_state
  local rec="${1:-}" action="${2:-}" rank="${3:-}" reason="${4:-}"
  [[ -n "$rec" && -n "$action" ]] || err "Usage: yuelao filter <recommendation_id> <shown|suppressed> [rank] [reason]"
  [[ "$action" == "shown" || "$action" == "suppressed" ]] || err "Action must be 'shown' or 'suppressed'"
  local uid payload
  uid=$(cfg user_id)
  payload=$(jq -n --arg u "$uid" --arg a "$action" --arg rk "$rank" --arg rs "$reason" \
    '{user_id:$u, action:$a,
      rank:   (if $rk == "" then null else ($rk | tonumber) end),
      reason: (if $rs == "" then null else $rs end)}')
  api POST "${API_BASE}/recommendations/${rec}/filter" "$payload" >/dev/null
  update_state --arg id "$rec" --arg a "$action" --arg rs "$reason" \
    '.filters[$id] = {action:$a, reason:$rs, ts:(now|floor)}'
  echo "Filter recorded: rec ${rec} -> ${action}"
}

cmd_respond() {
  require_config; ensure_state
  local action="${1:-}" rec="${2:-}" reason="" force=0 arg
  shift 2 2>/dev/null || err "Usage: yuelao respond <accept|reject> <recommendation_id> [reason] [--force]"
  for arg in "$@"; do
    if [[ "$arg" == "--force" ]]; then force=1; else reason="$arg"; fi
  done
  [[ "$action" == "accept" || "$action" == "reject" ]] || err "Action must be 'accept' or 'reject'"

  # 强制"先筛后展"：没有 filter 记录的推荐不能直接回应
  local verdict
  verdict=$(jq -r --arg id "$rec" '.filters[$id].action // empty' "$STATE")
  if [[ -z "$verdict" && "$force" -ne 1 ]]; then
    err "推荐 ${rec} 还没有筛选记录，不能直接回应。正确顺序：先运行 yuelao filter ${rec} <shown|suppressed> [rank] [reason] 回传你的判断，再展示给用户，用户亲口表态后才 respond。"
  fi

  local uid payload
  uid=$(cfg user_id)
  payload=$(jq -n --arg u "$uid" --arg r "$rec" --arg a "$action" --arg rs "$reason" \
    "${JQ_ID}"' {user_id:$u, recommendation_id:($r|as_id), response:$a, reason:$rs}')
  api POST "${API_BASE}/response" "$payload"
  echo "Response recorded: ${action} (rec ${rec})"
}

cmd_exchange() {
  require_config; ensure_state
  local action="${1:-}" mid="${2:-}"
  [[ -n "$action" && -n "$mid" ]] || err "Usage: yuelao exchange <submit|get> <match_id> [contact]"
  local uid; uid=$(cfg user_id)
  case "$action" in
    submit)
      local contact="${3:-}"
      if [[ -z "$contact" ]]; then
        local ct cv
        ct=$(jq -r '.contact.type // empty' "$CONFIG")
        cv=$(jq -r '.contact.value // empty' "$CONFIG")
        [[ -n "$cv" ]] || err "No contact info. Run: yuelao contact set wechat <微信号>  (or pass contact as argument)"
        contact="${ct}:${cv}"
      fi
      local payload
      payload=$(jq -n --arg u "$uid" --arg c "$contact" '{user_id:$u, contact:$c}')
      api POST "${API_BASE}/exchange/${mid}" "$payload" >/dev/null
      update_state --arg m "$mid" '.exchanges[$m] = ((.exchanges[$m] // {}) + {submitted:true, submitted_at:(now|floor)})'
      echo "Contact submitted for match ${mid}. Waiting for the other party."
      ;;
    get)
      local res c
      res=$(api GET "${API_BASE}/exchange/${mid}?user_id=${uid}")
      c=$(echo "$res" | jq -r '.contact // empty')
      if [[ -n "$c" ]]; then
        update_state --arg m "$mid" --arg c "$c" \
          '.exchanges[$m] = ((.exchanges[$m] // {}) + {partner_contact:$c, received_at:(now|floor)})'
        echo "Match ${mid} contact: ${c}"
      else
        echo "Waiting for the other party to submit their contact info."
      fi
      ;;
    *) err "Usage: yuelao exchange <submit|get> <match_id> [contact]" ;;
  esac
}

cmd_message() {
  require_config; ensure_state
  local uid; uid=$(cfg user_id)
  case "${1:-}" in
    send)
      local rec="${2:-}" msg="${3:-}"
      [[ -n "$rec" && -n "$msg" ]] || err "Usage: yuelao message send <recommendation_id> \"<message>\""
      local payload
      payload=$(jq -n --arg u "$uid" --arg r "$rec" --arg m "$msg" \
        "${JQ_ID}"' {user_id:$u, recommendation_id:($r|as_id), message:$m}')
      api POST "${API_BASE}/messages" "$payload"
      ;;
    inbox) api GET "${API_BASE}/messages/${uid}" ;;
    read)
      local mid="${2:-}"
      [[ -n "$mid" ]] || err "Usage: yuelao message read <message_id>"
      local payload
      payload=$(jq -n --arg u "$uid" '{user_id:$u}')
      api POST "${API_BASE}/messages/${mid}/read" "$payload"
      ;;
    *) err "Usage: yuelao message <send|inbox|read> [args]" ;;
  esac
}

cmd_feedback() {
  local rec="${2:-}" data="${3:-}"
  if [[ "${1:-}" == "submit" ]]; then
    [[ -n "$rec" && -n "$data" ]] || err "Usage: yuelao feedback submit <recommendation_id> '<json>'"
    require_json "$data"
  fi
  require_config; ensure_state
  local uid; uid=$(cfg user_id)
  case "${1:-}" in
    submit)
      local payload
      payload=$(echo "$data" | jq --arg u "$uid" --arg r "$rec" \
        "${JQ_ID}"' . + {user_id:$u, recommendation_id:($r|as_id)}')
      api POST "${API_BASE}/feedback" "$payload" >/dev/null
      update_state --arg r "$rec" '.feedback = ((.feedback + [$r]) | unique)'
      echo "Feedback recorded for rec ${rec}."
      ;;
    list) api GET "${API_BASE}/feedback/${uid}" ;;
    *) err "Usage: yuelao feedback <submit|list> [args]" ;;
  esac
}

cmd_pause() {
  require_config
  local uid; uid=$(cfg user_id)
  case "${1:-}" in
    on)
      local reason="${2:-}" payload
      payload=$(jq -n --arg r "$reason" '{status:"paused", reason:$r}')
      api POST "${API_BASE}/profile/${uid}/pause" "$payload"
      ;;
    off)    api POST "${API_BASE}/profile/${uid}/resume" '{}' ;;
    status) api GET "${API_BASE}/profile/${uid}/pause" ;;
    *) err "Usage: yuelao pause <on|off|status> [reason]" ;;
  esac
}

# 深度合并：object 递归合并；纯字符串数组取并集，保留原有顺序、新值追加在后
# （不能用 unique——它会重排，把用户表达的先后强调顺序打乱）；
# 其他数组（如 age_range 数字对）整体替换。删除元素请用 profile set 全量替换。
JQ_DEEPMERGE='
  def dm(a; b):
    if (a|type) == "object" and (b|type) == "object" then
      reduce (((a|keys) + (b|keys)) | unique | .[]) as $k ({}; .[$k] = dm(a[$k]; b[$k]))
    elif (a|type) == "array" and (b|type) == "array" and ((a + b) | all(type == "string")) then
      reduce (a + b)[] as $x ([]; if index($x) then . else . + [$x] end)
    elif b == null then a
    else b end;
'

ensure_cache() {
  if [[ ! -f "$CACHE" ]]; then
    local uid remote
    uid=$(cfg user_id)
    remote=$(api GET "${API_BASE}/profile/${uid}")
    echo "$remote" | jq '{summary: .summary, preferences: .preferences}' > "$CACHE"
    chmod 600 "$CACHE"
  fi
}

cmd_profile() {
  local validated
  if [[ "${1:-}" == "update" || "${1:-}" == "set" ]]; then
    [[ -n "${2:-}" ]] || err "Usage: yuelao profile ${1} '<json>' (or file / - for stdin)"
    validated=$(read_json_input "$2") || exit 1
  fi
  require_config
  local uid; uid=$(cfg user_id)
  case "${1:-}" in
    get)
      local res; res=$(api GET "${API_BASE}/profile/${uid}")
      echo "$res" | jq '{summary: .summary, preferences: .preferences}' > "$CACHE" 2>/dev/null || true
      chmod 600 "$CACHE" 2>/dev/null || true
      echo "$res"
      ;;
    update)
      local new="$validated"
      ensure_cache
      local merged res
      merged=$(jq -n --argjson cache "$(cat "$CACHE")" --argjson new "$new" \
        "${JQ_DEEPMERGE} dm(\$cache; \$new)")
      # 失败必须中止，且**不碰缓存**。原来的写法是 `api PATCH … >/dev/null`，
      # 返回码没人看：更新失败时照样把本地合并结果写进缓存，于是本地缓存和服务端
      # 从此不一致，而后续每次增量合并都建立在这个谎话上。
      res=$(api PATCH "${API_BASE}/profile/${uid}" "$merged") \
        || err "Profile update failed; local cache left unchanged."
      # 缓存以**服务端响应**为准（它的值才是权威的，可能被规范化过），
      # 不是我们本地拼出来的那份。
      printf '%s\n' "$res" | jq '{summary, preferences}' > "$CACHE"
      chmod 600 "$CACHE"
      echo "Profile updated (merged)."
      print_eligibility "$res"
      ;;
    set)
      local full="$validated"
      local res
      res=$(api PATCH "${API_BASE}/profile/${uid}" "$full") \
        || err "Profile replace failed; local cache left unchanged."
      printf '%s\n' "$res" | jq '{summary, preferences}' > "$CACHE"
      chmod 600 "$CACHE"
      echo "Profile replaced."
      print_eligibility "$res"
      ;;
    cache) [[ -f "$CACHE" ]] && cat "$CACHE" || echo '{}' ;;
    delete)
      api DELETE "${API_BASE}/profile/${uid}" >/dev/null
      rm -f "$CONFIG" "$CACHE" "$STATE"
      echo "Profile deleted on server. All local files removed."
      ;;
    *) err "Usage: yuelao profile <get|update|set|cache|delete> [json]" ;;
  esac
}

cmd_status() {
  migrate_config
  if [[ ! -f "$CONFIG" ]]; then
    echo '{"registered": false}'
    return 0
  fi
  ensure_state
  jq -n \
    --arg uid "$(cfg user_id)" \
    --arg backend "$(cfg backend_url)" \
    --arg ctype "$(jq -r '.contact.type // ""' "$CONFIG")" \
    --argjson contact_set "$(jq '(.contact.value // "") != ""' "$CONFIG")" \
    --argjson last_sync "$(jq '.last_sync // 0' "$STATE")" \
    --argjson has_cache "$([[ -f "$CACHE" ]] && echo true || echo false)" \
    '{registered: true, user_id: $uid, backend: $backend,
      contact_set: $contact_set, contact_type: $ctype,
      last_sync: $last_sync, profile_cached: $has_cache}'
}

cmd_help() {
  cat <<'EOF'
yuelao — 红娘 skill 统一 CLI

  register '<json>' [backend_url]        注册（json 也可为文件路径或 - 读 stdin）
  status                                 本地状态概览（是否注册、联系方式是否已设置）
  sync                                   拉取全部最新数据 + 与上次快照对比，输出变化摘要
  contact set <type> <value>             设置联系方式（只存本地）
  contact get                            查看联系方式
  filter <rec_id> <shown|suppressed> [rank] [reason]
                                         回传红娘筛选判断（展示给用户之前必须先做）
  respond <accept|reject> <rec_id> [reason]
                                         回应推荐（要求该推荐已有 filter 记录；
                                         --force 仅用于本地状态丢失后的人工修复）
  exchange submit <match_id> [contact]   提交联系方式（默认读本地 contact）
  exchange get <match_id>                获取对方联系方式
  message send <rec_id> "<msg>"          传话给对方
  message inbox                          查看收到的传话
  message read <msg_id>                  标记已读
  feedback submit <rec_id> '<json>'      约会后反馈 {"outcome":"chatting|met|dating|ended","rating":1-5,"comment":"..."}
  feedback list                          查看已提交反馈
  pause <on|off|status> [reason]         暂停/恢复匹配
  profile get                            查看档案（同时刷新本地缓存）
  profile update '<json>'                增量更新（object 深合并，字符串数组并集，其他数组替换）
  profile set '<full_json>'              全量替换（需要删除数组元素时用这个）
  profile cache                          查看本地缓存的档案
  profile delete                         注销并删除所有本地数据
EOF
}

# ---------- 分发 ----------

# 用 NUL 分隔参数，避免跨参数拼成合法字符；一次校验后再进入 jq 或本地写入。
if [[ "$#" -gt 0 ]]; then printf '%s\0' "$@" | require_utf8; fi
CMD="${1:-help}"
shift || true
case "$CMD" in
  register) cmd_register "$@" ;;
  contact)  cmd_contact "$@" ;;
  sync)     cmd_sync "$@" ;;
  filter)   cmd_filter "$@" ;;
  respond)  cmd_respond "$@" ;;
  exchange) cmd_exchange "$@" ;;
  message)  cmd_message "$@" ;;
  feedback) cmd_feedback "$@" ;;
  pause)    cmd_pause "$@" ;;
  profile)  cmd_profile "$@" ;;
  status)   cmd_status "$@" ;;
  help|-h|--help) cmd_help ;;
  *) err "Unknown command: $CMD (run 'yuelao help')" ;;
esac
